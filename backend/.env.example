# Copie este arquivo para .env e preencha com os seus valores.
# O .env NÃO deve ir para o Git.

PORT=3000

# Banco de dados (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=controle_financeiro

# JWT
JWT_SECRET=troque_por_uma_frase_longa_e_dificil_de_adivinhar
JWT_EXPIRES_IN=1h

# Origem do front-end liberada no CORS (Vite usa a porta 5173)
CORS_ORIGIN=http://localhost:5173
